# ==============================================================================
# GitHub Issue Triage ML - Environment Variables Template
# ==============================================================================
# Copy this file to .env and configure your settings:
#   cp .env.example .env
#
# DO NOT commit .env with real credentials to version control.
# ==============================================================================

# GitHub Personal Access Token (Optional)
# Unauthenticated requests are limited to 60 req/hour by GitHub API.
# Authenticated requests increase the limit to 5,000 req/hour.
GITHUB_TOKEN=your_github_personal_access_token_here

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO

# Serving / API Configuration
HOST=0.0.0.0
PORT=8000
